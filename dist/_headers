/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://itservices-rajat-agarwal.pages.dev")
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-src https://itservices-rajat-agarwal.pages.dev; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json
/*.png
  Cache-Control: public, max-age=86400
/api/*
  Cache-Control: no-store
